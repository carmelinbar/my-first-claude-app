datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Status is a plain string rather than a Prisma enum, so adding a new
// status value never needs a schema migration.
// User.status: "active" | "blocked", UseCase.status: "active" | "paused".
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  team          String?
  monthlyBudget Float    @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())

  // When set, this user's real Anthropic Console workspace. "Sync real
  // usage" pulls that workspace's month-to-date cost from the Anthropic
  // Cost Admin API into syncedSpend (the Cost API only breaks spend down
  // by workspace, not by individual API key, so a workspace per pilot
  // user is required for this to attribute spend to the right person).
  anthropicWorkspaceId String?
  syncedSpend           Float    @default(0)
  lastSyncedAt          DateTime?

  useCases     UseCase[]
  usageEntries UsageEntry[]
}

model UseCase {
  id          String   @id @default(cuid())
  name        String
  description String?
  budgetCap   Float    @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  usageEntries UsageEntry[]
}

model UsageEntry {
  id     String   @id @default(cuid())
  amount Float
  note   String?
  date   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  useCaseId String?
  useCase   UseCase? @relation(fields: [useCaseId], references: [id], onDelete: SetNull)
}
